-- procedure

create procedure add_product(
p_name varchar(10),
p_sku varchar(10),
p_price numeric(10,2),
p_stock int,
is_avl bool,
category char
)
language plpgsql
as $$
begin
insert into products(name, sku_code,
price, stock_quantity, is_available, category)
values(p_name,p_sku, p_price,p_stock, is_avl, category);

end;
$$;



