class Book:
    def __init__(self,name,price):
        self.name=name
        self.price=int(price)
    def show(self):
        print(f"name of book is {self.name} and its price is {self.price}")
books=[
    Book("Physics",800),
    Book("Chemistry",700),
    Book("Math",1000)
]                           

for a in books:
    a.show()
